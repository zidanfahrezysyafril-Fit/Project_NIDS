# ============================================================
# CONTOH KONFIGURASI DATABASE
# Salin file ini menjadi .env lalu sesuaikan dengan database Anda
# ============================================================

# Opsi 1: XAMPP (MySQL / MariaDB)
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nids_monitor

# Opsi 2: PostgreSQL (Alternatif)
# DATABASE_URL=postgresql+psycopg2://postgres:root@127.0.0.1:5432/nids_monitor

# Secret key Flask
SECRET_KEY=nids-monitor-kelompok10-cybersecurity-secret-key-2026

# Konfigurasi AI Security Assistant (Opsional)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Konfigurasi Notifikasi Telegram Bot (Opsional)
TELEGRAM_BOT_TOKEN=
